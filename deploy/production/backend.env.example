# Copy to /etc/vulnora/backend.env and replace every CHANGE_ME value out of Git.
# File mode must be 0600 and ownership must be vulnora:vulnora.
AGENT_DB_PATH=/var/lib/vulnora/agent.sqlite3
# Owner authentication is initialized once through the interactive CLI. Do not
# set a legacy AGENT_API_TOKEN in this deployment mode.
AGENT_REQUIRE_OWNER_AUTH=1
AGENT_OWNER_EMAIL=ashbm1995@gmail.com
AGENT_SESSION_TTL_SECONDS=28800
AGENT_AUTH_MAX_FAILED_ATTEMPTS=5
AGENT_AUTH_LOCKOUT_SECONDS=300
AGENT_AUTH_MAX_LOGIN_ATTEMPTS=20
AGENT_AUTH_RATE_WINDOW_SECONDS=60
AGENT_AUTH_MAX_CONCURRENT_KDFS=2
AGENT_COOKIE_SECURE=1
AGENT_COOKIE_SAMESITE=lax
AGENT_ALLOWED_ORIGINS=
AGENT_HTTP_TIMEOUT=15
AGENT_MAX_ATTEMPTS=2
AGENT_WORKER_ID=oci-worker-1
AGENT_WORKER_LEASE_TTL=60
AGENT_WORKER_HEARTBEAT=20
AGENT_WORKER_MAX_AGE=300
AGENT_WORKER_POLL_INTERVAL=0.1
AGENT_WORKER_IDLE_INTERVAL=1.0
AGENT_WORKER_ERROR_BACKOFF=1.0
AGENT_LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash
# Leave unset for the deterministic local planner used by the control-plane
# test deployment. If LLM planning is explicitly required, inject a real key
# through the protected environment/secret mechanism; never commit it here.
# GEMINI_API_KEY=
AGENT_LLM_TIMEOUT=30
AGENT_LLM_MAX_RETRIES=2
AGENT_LLM_BACKOFF_BASE=0.5
AGENT_LLM_BACKOFF_MAX=8

# Scanner execution remains disabled until the dedicated OCI runtime acceptance suite passes.
AGENT_HTTPX_BINARY=httpx
AGENT_NUCLEI_BINARY=nuclei
AGENT_NUCLEI_TEMPLATES_DIR=
AGENT_NUCLEI_MANIFEST_SHA256=
