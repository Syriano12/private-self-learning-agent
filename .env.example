AGENT_DB_PATH=data/agent.sqlite3
# Owner authentication is initialized interactively; do not configure a
# legacy bearer token for an internet-facing deployment.
AGENT_REQUIRE_OWNER_AUTH=1
AGENT_OWNER_EMAIL=ashbm1995@gmail.com
# Set to 0 only for explicit loopback development.
AGENT_COOKIE_SECURE=1
AGENT_COOKIE_SAMESITE=lax
AGENT_ALLOWED_ORIGINS=
AGENT_HTTP_TIMEOUT=15
AGENT_MAX_ATTEMPTS=2
AGENT_WORKER_ID=local-worker
AGENT_WORKER_LEASE_TTL=60
AGENT_WORKER_HEARTBEAT=20
AGENT_WORKER_MAX_AGE=300
AGENT_WORKER_POLL_INTERVAL=0.1
AGENT_WORKER_IDLE_INTERVAL=1.0
AGENT_WORKER_ERROR_BACKOFF=1.0
AGENT_LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash
AGENT_LLM_TIMEOUT=30
AGENT_LLM_MAX_RETRIES=2
AGENT_LLM_BACKOFF_BASE=0.5
AGENT_LLM_BACKOFF_MAX=8
# Optional Phase 25 scanner adapters; missing/unverified values fail closed.
AGENT_HTTPX_BINARY=httpx
AGENT_NUCLEI_BINARY=nuclei
AGENT_NUCLEI_TEMPLATES_DIR=
AGENT_NUCLEI_MANIFEST_SHA256=
# Phase 26: complete signed-release metadata is required before a scanner can be provisioned.
AGENT_HTTPX_VERSION=
AGENT_HTTPX_ARCHIVE_PATH=
AGENT_HTTPX_ARCHIVE_MEMBER=httpx
AGENT_HTTPX_ASSET_NAME=
AGENT_HTTPX_CHECKSUM_FILE=
AGENT_HTTPX_SIGNATURE_FILE=
AGENT_HTTPX_KEYRING_PATH=
AGENT_HTTPX_SIGNER_FINGERPRINT=
AGENT_HTTPX_RELEASE_URL=
AGENT_NUCLEI_VERSION=
AGENT_NUCLEI_ARCHIVE_PATH=
AGENT_NUCLEI_ARCHIVE_MEMBER=nuclei
AGENT_NUCLEI_ASSET_NAME=
AGENT_NUCLEI_CHECKSUM_FILE=
AGENT_NUCLEI_SIGNATURE_FILE=
AGENT_NUCLEI_KEYRING_PATH=
AGENT_NUCLEI_SIGNER_FINGERPRINT=
AGENT_NUCLEI_RELEASE_URL=
# Supply GEMINI_API_KEY only in the local environment; never commit it.
